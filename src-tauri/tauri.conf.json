{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Super Agent OS",
  "version": "0.1.0",
  "identifier": "com.superagentos.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && ./scripts/fetch-pi.sh"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Super Agent OS",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": "frame-src sagent0: sagent1: sagent2: sagent3: sagent4: sagent5: sagent6: sagent7: sagent8: sagent9: sagent10: sagent11:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../samples/": "samples",
      "binaries/pi/": "pi"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
